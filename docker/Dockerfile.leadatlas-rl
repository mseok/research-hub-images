# Reusable RunPod GPU runtime image for LeadAtlas Wave 2 SFT/GRPO campaigns.
# Contains ONLY public open-source packages (no proprietary code, keys, or data).
# Installs directly on top of RunPod's PyTorch 2.8.0 CUDA 12.8.1 Python without overriding torch/torchvision.
FROM runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_INSTALL_DIR=/usr/local/bin \
    PATH=/usr/local/bin:/root/.local/bin:$PATH

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && python3 -c "import torch, torchvision; print(f'torch=={torch.__version__}\ntorchvision=={torchvision.__version__}')" > /tmp/torch-constraints.txt \
    && python3 -m pip install --no-cache-dir --upgrade-strategy only-if-needed \
        -c /tmp/torch-constraints.txt \
        "transformers>=4.46" "peft>=0.13" accelerate datasets \
        rdkit scipy pyyaml "openai>=3.55.0" \
    && python3 -c "import torch, torchvision, transformers, peft, accelerate, datasets, rdkit, scipy, yaml, openai; print('OK', torch.__version__)" \
    && rm -rf /root/.cache/pip /root/.cache/uv /tmp/torch-constraints.txt /tmp/*
